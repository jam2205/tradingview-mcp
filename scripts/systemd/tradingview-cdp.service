[Unit]
Description=TradingView Desktop with Chrome DevTools Protocol enabled
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/tradingview-mcp/scripts/systemd/launch_tv_service.sh
Restart=on-failure
RestartSec=5
# 9223: port 9222 is used by the Chrome/TradingView-web CDP session on this machine
Environment=TV_CDP_PORT=9223
Environment=TV_LAUNCH_WATCHDOG_S=20

[Install]
WantedBy=graphical-session.target
